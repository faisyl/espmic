# ESPMIC server environment configuration.
# Copy this file to .env and adjust values as needed.

# ======================================================================
# User / group that the container runs as (for host bind-mount ownership).
# Set these to your host UID/GID so recordings are browsable without sudo.
# Run `id -u` and `id -g` on the host to find yours.
# ======================================================================
ESPMIC_UID=1000
ESPMIC_GID=1000

# ======================================================================
# Host directory for persistent data (SQLite DB + recordings).
# This directory is bind-mounted into the container at /data.
# Must be pre-created and owned by the UID/GID above:
#   mkdir -p "$ESPMIC_DATA_DIR"
#   sudo chown -R <uid>:<gid> "$ESPMIC_DATA_DIR"
# ======================================================================
ESPMIC_DATA_DIR=./data

# ======================================================================
# Network / advertise settings (used by the server to tell devices where
# to send RTP). Set ESPMIC_ADVERTISE_HOST to the host's LAN IP reachable
# by ESP32 devices.
# ======================================================================
ESPMIC_ADVERTISE_HOST=192.168.1.100
ESPMIC_ADVERTISE_RTP_PORT=5004

# ======================================================================
# Build-time metadata (set by CI / docker compose build).
# ======================================================================
GIT_COMMIT=dev
BUILD_VERSION=dev
BUILD_DATE=unknown
