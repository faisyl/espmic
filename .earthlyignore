# Earthly does NOT read .gitignore. This file keeps generated build artifacts
# out of the build context so the context hash (and therefore the layer cache)
# only changes when the SOURCE changes — otherwise `COPY client ./client`
# sweeps hundreds of MB of build output into every build and busts the cache.
#
# Keep this tight but correct: nothing the firmware/host builds actually read
# at build time may be excluded (sdkconfig.defaults*, main/idf_component.yml,
# components/, CMakeLists.txt, partitions.csv are all required).

# VCS
.git

# Server release artifacts — never part of firmware builds
dist/

# ESP-IDF build output + generated config (hundreds of MB; regenerated in-container)
client/build*
client/sdkconfig
client/sdkconfig.old
client/managed_components
client/dependencies.lock

# Host unit-test build artifacts (regenerated by make test)
client/test/build/
client/test/*.o
client/test/test_rtp
client/test/test_control_frame
client/test/test_pcm_ring
client/test/test_encoded_queue
client/test/test_state_machine

# Misc generated files
**/*.o
**/__pycache__/
**/*.pyc